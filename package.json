{
  "name": "wiggle-room",
  "version": "1.0.0",
  "description": "Emote charades in Decentraland — act out a prompt with your avatar, everyone else guesses.",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.26.0",
    "@dcl/sdk": "7.26.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}